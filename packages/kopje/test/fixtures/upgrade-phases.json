{
  "rules": [
    {
      "schema": "pending",
      "hold": "any",
      "upgrading": "any",
      "refusals": {
        "read": "schema-pending",
        "session": "schema-pending",
        "write": "schema-pending",
        "media-delete": "schema-pending",
        "media-rebuild": "schema-pending"
      },
      "readonly": true
    },
    {
      "schema": "diverged",
      "hold": "any",
      "upgrading": "any",
      "refusals": {
        "read": "schema-diverged",
        "session": "schema-diverged",
        "write": "schema-diverged",
        "media-delete": "schema-diverged",
        "media-rebuild": "schema-diverged"
      },
      "readonly": true
    },
    {
      "schema": "current",
      "hold": "set",
      "upgrading": "any",
      "refusals": { "read": null, "session": null, "write": "hold", "media-delete": "hold", "media-rebuild": "hold" },
      "readonly": true
    },
    {
      "schema": "current",
      "hold": null,
      "upgrading": true,
      "refusals": {
        "read": null,
        "session": null,
        "write": "upgrade-in-progress",
        "media-delete": "upgrade-in-progress",
        "media-rebuild": "upgrade-in-progress"
      },
      "readonly": true
    },
    {
      "schema": "current",
      "hold": null,
      "upgrading": false,
      "refusals": { "read": null, "session": null, "write": null, "media-delete": null, "media-rebuild": null },
      "readonly": false
    }
  ],
  "examples": [
    {
      "id": "pending",
      "label": "Migrations pending, none applied yet",
      "schema": "pending",
      "hold": null,
      "upgrading": false
    },
    {
      "id": "stopped-applying",
      "label": "Stopped while applying, until the next attempt",
      "schema": "pending",
      "hold": null,
      "upgrading": true
    },
    {
      "id": "stopped-verifying",
      "label": "Stopped before verifying, until the next attempt",
      "schema": "current",
      "hold": null,
      "upgrading": true
    },
    {
      "id": "bookmark-failed",
      "label": "Held: `bookmark-failed`, before the upgrade is recorded",
      "schema": "pending",
      "hold": "bookmark-failed",
      "upgrading": false
    },
    {
      "id": "bookmark-failed-recorded",
      "label": "Held: `bookmark-failed`, once the upgrade is recorded",
      "schema": "pending",
      "hold": "bookmark-failed",
      "upgrading": true
    },
    {
      "id": "bookmark-failed-overlapping",
      "label": "Held: `bookmark-failed` by an attempt that overlapped one that finished",
      "schema": "current",
      "hold": "bookmark-failed",
      "upgrading": false
    },
    {
      "id": "bookmark-failed-overlapping-verify-failed",
      "label": "Held: `bookmark-failed` by an attempt that overlapped one that failed to verify",
      "schema": "current",
      "hold": "bookmark-failed",
      "upgrading": true
    },
    {
      "id": "upgrade-failed-unapplied",
      "label": "Held: `upgrade-failed`, a migration unapplied",
      "schema": "pending",
      "hold": "upgrade-failed",
      "upgrading": true
    },
    {
      "id": "upgrade-failed-applied",
      "label": "Held: `upgrade-failed`, every migration applied",
      "schema": "current",
      "hold": "upgrade-failed",
      "upgrading": true
    },
    {
      "id": "upgrade-failed-unread",
      "label": "Held: `upgrade-failed`, its state not read back, in the isolate that failed",
      "schema": "pending",
      "hold": "upgrade-failed",
      "upgrading": false
    },
    {
      "id": "verify-failed",
      "label": "Held: `verify-failed`, before verification is recorded",
      "schema": "current",
      "hold": "verify-failed",
      "upgrading": true
    },
    {
      "id": "verify-failed-recorded",
      "label": "Held: `verify-failed`, once verification is recorded",
      "schema": "current",
      "hold": "verify-failed",
      "upgrading": false
    },
    { "id": "diverged", "label": "Schema diverged", "schema": "diverged", "hold": null, "upgrading": false },
    {
      "id": "diverged-unfinished",
      "label": "Schema diverged, an upgrade left unfinished",
      "schema": "diverged",
      "hold": null,
      "upgrading": true
    },
    { "id": "upgraded", "label": "Upgraded", "schema": "current", "hold": null, "upgrading": false }
  ]
}
